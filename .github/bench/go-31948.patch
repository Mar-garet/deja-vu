@@ -103,3 +113,127 @@ func DefaultDir() (string, bool, error) {
 
 	return defaultDir, defaultDirChanged, defaultDirErr
 }
+
+// "go clean -cache" removes entries that a concurrent go command may still
+// need (go.dev/issue/31948). To prevent that, a go command using the cache
+// holds a shared lock on GOCACHE/clean.lock until it exits, and
+// "go clean -cache" waits for an exclusive lock on it before removing
+// anything. A waiting clean does not block other go commands, so it waits
+// until there is a moment when no go command is using the cache.
+//
+// User programs run by a go command that holds the lock (tests, go generate
+// commands, go tool and go run programs on Windows) get the locked directory
+// in $GOCACHE_INTERNAL_LOCKED. A go command started by them does not lock
+// that cache again: a build is covered by its ancestor's lock, and
+// "go clean -cache" would otherwise wait for its own ancestor forever.
+// Such a clean does not wait at all, as before.
+const lockedEnv = "GOCACHE_INTERNAL_LOCKED"
+
+var sharedLock *lockedfile.File
+
+// lockShared takes the shared lock on the cache in dir, if possible.
+// The lock is held until the go command exits or calls Unlock.
+func lockShared(dir string) {
+	if !canLock(dir) {
+		return
+	}
+	// The lock file gets the umask, usually 0644. In a cache shared by
+	// several users, a clean run by a user other than its creator
+	// cannot open it for writing and does not wait (see LockExclusive).
+	f, err := lockedfile.OpenFile(lockFile(dir), os.O_RDONLY|os.O_CREATE, 0o666)
+	if err != nil {
+		// Locking is best-effort: the cache may be read-only,
+		// or the platform may not support file locks.
+		return
+	}
+	sharedLock = f
+	base.AtExit(func() {
+		// The operating system may not release the lock promptly at exit.
+		if sharedLock != nil {
+			sharedLock.Close()
+			sharedLock = nil
+		}
+	})
+	locked := dir
+	if old := os.Getenv(lockedEnv); old != "" {
+		locked = old + string(filepath.ListSeparator) + dir
+	}
+	// Only user programs see this, not a re-executed toolchain,
+	// which does not inherit the lock.
+	setOrigEnv(locked)
+}
+
+// Unlock releases the shared lock on the default cache for a go command
+// that is done with the cache but keeps running, such as "go run" while the
+// program runs. On Windows, where a running executable cannot be removed,
+// it keeps the lock: the program may have been run from the cache.
+func Unlock() {
+	if sharedLock == nil || runtime.GOOS == "windows" {
+		return
+	}
+	sharedLock.Close()
+	sharedLock = nil
+	setOrigEnv(os.Getenv(lockedEnv))
+}
+
+func setOrigEnv(locked string) {
+	cfg.OrigEnv = slices.DeleteFunc(cfg.OrigEnv, func(kv string) bool {
+		return strings.HasPrefix(kv, lockedEnv+"=")
+	})
+	if locked != "" {
+		cfg.OrigEnv = append(cfg.OrigEnv, lockedEnv+"="+locked)
+	}
+}
+
+// LockExclusive waits until no other go command uses the cache in dir and
+// keeps new ones from starting until unlock is called. If dir is locked by
+// a go command that started this one, or cannot be locked, LockExclusive
+// does nothing.
+func LockExclusive(dir string) (unlock func()) {
+	if sharedLock != nil {
+		// This go command used the cache itself,
+		// for example to load packages for "go clean -i -cache".
+		sharedLock.Close()
+		sharedLock = nil
+	} else if !canLock(dir) {
+		// A clean run during "go test" can still remove entries that
+		// the parent uses for other packages, as before.
+		return func() {}
+	}
+	t := time.AfterFunc(time.Second, func() {
+		fmt.Fprintf(os.Stderr, "go: waiting for other go commands to finish using %s\n", dir)
+	})
+	f, err := lockedfile.OpenFile(lockFile(dir), os.O_RDWR|os.O_CREATE, 0o666)
+	t.Stop()
+	if err != nil {
+		// Such as a lock file created by another user: an exclusive
+		// lock needs it open for writing. Clean without waiting, as before.
+		return func() {}
+	}
+	return func() { f.Close() }
+}
+
+func canLock(dir string) bool {
+	// On Plan 9, lockedfile only provides exclusive locks,
+	// which would serialize all go commands.
+	if runtime.GOOS == "plan9" {
+		return false
+	}
+	// A program may name its parent's cache by another path, such as a symlink.
+	fi, err := os.Stat(dir)
+	for _, locked := range filepath.SplitList(os.Getenv(lockedEnv)) {
+		if locked == dir {
+			return false
+		}
+		if err == nil {
+			if lfi, err := os.Stat(locked); err == nil && os.SameFile(fi, lfi) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func lockFile(dir string) string {
+	return filepath.Join(dir, "clean.lock")
+}
diff --git a/src/cmd/go/internal/cache/default_test.go b/src/cmd/go/internal/cache/default_test.go
new file mode 100644
index 0000000000..496852b25c
--- /dev/null
+++ b/src/cmd/go/internal/cache/default_test.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build !js && !plan9 && !wasip1
+
+package cache
+
+import (
+	"internal/testenv"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+	"time"
+
+	"cmd/go/internal/cfg"
+	"cmd/go/internal/lockedfile"
+)
+
+func TestLockExclusiveWaitsForShared(t *testing.T) {
+	dir := t.TempDir()
+	shared, err := lockedfile.OpenFile(lockFile(dir), os.O_RDONLY|os.O_CREATE, 0o666)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	locked := make(chan func())
+	go func() { locked <- LockExclusive(dir) }()
+	select {
+	case unlock := <-locked:
+		unlock()
+		t.Fatal("LockExclusive returned while the cache was locked for use")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	shared.Close()
+	unlock := <-locked
+	unlock()
+}
+
+func TestLockSharedThenExclusive(t *testing.T) {
+	t.Setenv(lockedEnv, "")
+	defer func(env []string) { cfg.OrigEnv = env }(cfg.OrigEnv)
+	cfg.OrigEnv = nil
+	dir := t.TempDir()
+
+	lockShared(dir)
+	if sharedLock == nil {
+		t.Fatal("lockShared did not lock")
+	}
+	if want := lockedEnv + "=" + dir; !slices.Contains(cfg.OrigEnv, want) {
+		t.Errorf("cfg.OrigEnv = %q, want %q", cfg.OrigEnv, want)
+	}
+
+	// The same process can take the exclusive lock.
+	LockExclusive(dir)()
+	if sharedLock != nil {
+		t.Error("LockExclusive did not release the shared lock")
+	}
+
+	// A process whose parent locked dir does not lock it.
+	t.Setenv(lockedEnv, dir)
+	lockShared(dir)
+	if sharedLock != nil {
+		sharedLock.Close()
+		sharedLock = nil
+		t.Error("lockShared locked a directory locked by the parent")
+	}
+
+	// Also when the parent named it through a symlink.
+	if testenv.HasSymlink() {
+		link := filepath.Join(t.TempDir(), "link")
+		if err := os.Symlink(dir, link); err != nil {
+			t.Fatal(err)
+		}
+		t.Setenv(lockedEnv, link)
+		lockShared(dir)
+		if sharedLock != nil {
+			sharedLock.Close()
+			sharedLock = nil
+			t.Error("lockShared locked a directory locked by the parent through a symlink")
+		}
+	}
+}
