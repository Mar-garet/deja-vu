diff --git a/src/cmd/go/testdata/script/clean_cache_lock.txt b/src/cmd/go/testdata/script/clean_cache_lock.txt
new file mode 100644
index 0000000000..36aaa58d4d
--- /dev/null
+++ b/src/cmd/go/testdata/script/clean_cache_lock.txt
@@ -0,0 +1,90 @@
+# 'go clean -cache' waits for go commands using the cache (go.dev/issue/31948),
+# but not for the go command that started it.
+
+[short] skip 'runs go test and go run'
+
+env GOCACHE=$WORK/cache
+
+# While 'go test' runs, a clean that does not know it was started by
+# 'go test' waits; one that does know cleans without waiting.
+go test -count=1 .
+stdout '^ok'
+
+# A program run by 'go run' can clean the cache.
+go run ./cleaner
+! exists $GOCACHE/00
+
+# 'go clean -i -cache' loads packages through the cache,
+# then cleans it without waiting for itself.
+go clean -i -cache
+
+-- go.mod --
+module example
+
+go 1.24
+-- main.go --
+package main
+
+import "os"
+
+func main() { os.Exit(0) }
+-- clean_test.go --
+package main
+
+import (
+	"bufio"
+	"os"
+	"os/exec"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCleanWaits(t *testing.T) {
+	cmd := exec.Command("go", "clean", "-cache")
+	cmd.Env = slices.DeleteFunc(os.Environ(), func(kv string) bool {
+		return strings.HasPrefix(kv, "GOCACHE_INTERNAL_LOCKED=")
+	})
+	stderr, err := cmd.StderrPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Wait()
+	defer cmd.Process.Kill()
+	s := bufio.NewScanner(stderr)
+	if !s.Scan() || !strings.Contains(s.Text(), "waiting for other go commands") {
+		t.Fatalf("go clean -cache did not wait for go test: %q", s.Text())
+	}
+}
+
+func TestCleanInTest(t *testing.T) {
+	done := make(chan error, 1)
+	go func() { done <- exec.Command("go", "clean", "-cache").Run() }()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Minute):
+		t.Fatal("go clean -cache waited for its own go test")
+	}
+}
+-- cleaner/main.go --
+package main
+
+import (
+	"os"
+	"os/exec"
+)
+
+func main() {
+	cmd := exec.Command("go", "clean", "-cache")
+	cmd.Stderr = os.Stderr
+	if err := cmd.Run(); err != nil {
+		panic(err)
+	}
+}
